<?xml version="1.0" encoding="utf-8"?><!--
    整页 Empty(无数据)状态默认布局(由 PageStateLayout inflate)。
    自定义约定:
    - ivPageStateIcon    提示图标(可缺省)
    - tvPageStateMessage 文案(可缺省,运行时覆盖)
    - btnPageStateRetry  重试入口(可缺省;缺省时该状态不可点按重试)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivPageStateIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/abs_ic_page_state_empty" />

    <TextView
        android:id="@+id/tvPageStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="暂无数据"
        android:textColor="@color/black_alpha"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnPageStateRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/abs_bg_button_outline"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="刷新试试"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp" />

</LinearLayout>
