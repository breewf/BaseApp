<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================= Banner 轮播(com.hy.basic.banner) ================= -->
    <declare-styleable name="Banner">
        <!-- 无限循环 -->
        <attr name="banner_loop" format="boolean" />
        <!-- 自动轮播 -->
        <attr name="banner_autoScroll" format="boolean" />
        <!-- 轮播间隔(ms) -->
        <attr name="banner_interval" format="integer" />
        <!-- 两侧露出相邻页的边距(px/dp),0 = 铺满 -->
        <attr name="banner_pageMargin" format="dimension" />
        <!-- 是否允许手势滑动 -->
        <attr name="banner_userScrollEnabled" format="boolean" />
        <!-- 翻页动画时长(ms),只影响平滑翻页(自动轮播 / next / prev / select) -->
        <attr name="banner_scrollDuration" format="integer" />
        <!-- 切换动画,取值见 BannerTransformer;2 / 6 是已移除的视差与层叠,编号不再复用 -->
        <attr name="banner_transformer">
            <enum name="none" value="0" />
            <enum name="fade" value="1" />
            <enum name="depth" value="3" />
            <enum name="zoom" value="4" />
            <enum name="zoomSlide" value="5" />
            <enum name="accordion" value="7" />
            <enum name="cube" value="8" />
            <enum name="cubeIn" value="9" />
            <enum name="flip" value="10" />
            <enum name="flipVertical" value="11" />
            <enum name="rotateUp" value="12" />
            <enum name="rotateDown" value="13" />
            <enum name="foreToBack" value="14" />
            <enum name="backToFore" value="15" />
            <enum name="tablet" value="16" />
            <enum name="zoomIn" value="17" />
            <enum name="scaleInOut" value="18" />
            <enum name="flow" value="19" />
        </attr>
        <!-- 图片模式下的缩放方式 -->
        <attr name="banner_scaleType">
            <enum name="centerCrop" value="0" />
            <enum name="fitXY" value="1" />
            <enum name="centerInside" value="2" />
            <enum name="fitCenter" value="3" />
        </attr>
        <!-- 内置指示器样式,不写就没有指示器 -->
        <attr name="banner_indicator" format="enum">
            <enum name="dots" value="0" />
            <enum name="dotsSlider" value="1" />
            <enum name="bar" value="2" />
            <enum name="text" value="3" />
        </attr>
        <!-- 指示器位置 -->
        <attr name="banner_indicatorGravity">
            <enum name="bottomCenter" value="0" />
            <enum name="bottomStart" value="1" />
            <enum name="bottomEnd" value="2" />
            <enum name="topCenter" value="3" />
            <enum name="topStart" value="4" />
            <enum name="topEnd" value="5" />
        </attr>
        <attr name="banner_indicatorMargin" format="dimension" />
        <attr name="banner_indicatorColor" format="color" />
        <attr name="banner_indicatorSelectedColor" format="color" />
    </declare-styleable>

    <declare-styleable name="BannerIndicator">
        <attr name="indicator_style" format="enum">
            <enum name="dots" value="0" />
            <enum name="dotsSlider" value="1" />
            <enum name="bar" value="2" />
            <enum name="text" value="3" />
        </attr>
        <!-- 页总数 -->
        <attr name="indicator_count" format="integer" />
        <!-- 未选中颜色 -->
        <attr name="indicatorColor" format="color" />
        <!-- 选中颜色 -->
        <attr name="indicatorSelectedColor" format="color" />
        <attr name="indicatorDotRadius" format="dimension" />
        <attr name="indicatorGap" format="dimension" />
        <attr name="indicatorBarHeight" format="dimension" />
        <attr name="indicatorBarLength" format="dimension" />
        <attr name="indicatorSelectedScale" format="float" />
        <attr name="indicatorTextSize" format="dimension" />
        <attr name="indicatorPadding" format="dimension" />
    </declare-styleable>
</resources>
