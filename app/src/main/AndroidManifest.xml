<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 用户权限 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 权限演示页用到:麦克风 / 通知(33+ 才是运行时权限) / 相册(33+ 分类媒体权限,以下回退存储) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="PhotoAndVideoPolicy" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/MyAppTheme">
        <!-- FileProvider:供相机直拍(LauncherSpec.TakePicture)把缓存文件转成可授权 Uri,
             authority 用 applicationId + .fileprovider,与代码里拼接规则一致 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hy.baseapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 旧测试总入口(baseapp 基类),已不再作为启动页 -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity android:name=".activity.ActivityStatusTestActivity" />
        <activity android:name=".activity.FragmentStatusActivity" />
        <activity android:name=".activity.PictureTestActivity" />
        <activity android:name=".activity.LoadingTestActivity" />
        <activity android:name=".activity.DialogTestActivity" />
        <activity android:name=".activity.MyDialogTestActivity" />
        <activity android:name=".activity.SnackBarTestActivity" />
        <activity android:name=".activity.BannerTestActivity" />
        <activity android:name="com.hy.baseapp.activity.IndexHomeActivity" />
        <activity android:name="com.hy.baseapp.activity.TabLayoutActivity" />
        <activity android:name=".activity.PaletteTestActivity" />
        <activity android:name=".activity.PaletteListTestActivity" />
        <activity android:name=".activity.RetrofitTestActivity" />
        <activity
            android:name=".activity.ActivityResultContractActivity"
            android:label="@string/activity_result_contract"
            android:theme="@style/AppTheme2" />
        <activity
            android:name=".activity.ActivityResultContract2Activity"
            android:label="@string/activity_result_contract2"
            android:theme="@style/AppTheme2" />
        <!-- 能力验证总入口:启动页 -->
        <activity
            android:name=".demo.DemoActivity"
            android:exported="true"
            android:label="@string/demo_hub_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 网络请求测试页 -->
        <activity
            android:name=".demo.network.NetworkTestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 整页多状态示例页 -->
        <activity
            android:name=".demo.state.PageStateDemoActivity"
            android:exported="false" />
        <!-- Fragment(ViewPager)多状态页面测试页 -->
        <activity
            android:name=".demo.state.FragmentPageStateActivity"
            android:exported="false" />
        <!-- 运行时权限演示页 -->
        <activity
            android:name=".demo.permission.PermissionDemoActivity"
            android:exported="false" />
        <!-- Dialog 弹窗演示页 -->
        <activity
            android:name=".demo.dialog.DialogDemoActivity"
            android:exported="false" />
        <!-- DialogFragment 弹框基类演示页(全屏/卡片弹框 + Material 底部面板) -->
        <activity
            android:name=".demo.dialog.DialogFragmentDemoActivity"
            android:exported="false" />
        <!-- Toast + Snackbar 提示演示页 -->
        <activity
            android:name=".demo.hint.HintDemoActivity"
            android:exported="false" />
        <!-- Banner 轮播演示页 -->
        <activity
            android:name=".demo.banner.BannerDemoActivity"
            android:exported="false" />
        <!-- 图片加载演示页 -->
        <activity
            android:name=".demo.image.ImageLoaderDemoActivity"
            android:exported="false" />
        <!-- 油价查询演示页(第三方裸 JSON 接口示例) -->
        <activity
            android:name=".demo.oilprice.OilPriceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 图片吸色主题演示页(Palette 取色 + 主题联动) -->
        <activity
            android:name=".demo.palette.PaletteThemeActivity"
            android:exported="false" />
        <!-- 列表组件演示页(竖向/横向/网格/瀑布流 + 下拉刷新 + 整页多状态) -->
        <activity
            android:name=".demo.list.ListDemoActivity"
            android:exported="false" />
        <!-- 富文本演示页(Spannable 常见用法 + 展开折叠/链接) -->
        <activity
            android:name=".demo.richtext.RichTextDemoActivity"
            android:exported="false" />
        <!-- 个人详情页(CollapsingToolbarLayout 折叠吸顶 + 视差头图 + Tab 吸顶联动) -->
        <activity
            android:name=".demo.profile.ProfileDemoActivity"
            android:exported="false" />
        <!-- ActivityResult 封装 + 统一事件通道演示页 -->
        <activity
            android:name=".demo.result.ActivityResultDemoActivity"
            android:exported="false" />
        <!-- 表单回传页(被 awaitResult 拉起,提交时发 ShowResult 事件) -->
        <activity
            android:name=".demo.result.ActivityResultFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 全局事件总线演示页(EventBus:一对多广播 + Fragment 间通信 + 粘性跨页) -->
        <activity
            android:name=".demo.event.EventBusDemoActivity"
            android:exported="false" />
        <!-- 粘性补收子页(晚创建仍能补收最近一次登录事件) -->
        <activity
            android:name=".demo.event.LoginReceiverActivity"
            android:exported="false" />
    </application>

</manifest>