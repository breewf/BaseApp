<?xml version="1.0" encoding="utf-8"?><!-- 春节喜欢态:描边与按压色用节日主色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/skin_festival_accent_soft" />
            <stroke
                android:width="@dimen/dimen_1"
                android:color="@color/skin_festival_accent" />
            <corners android:radius="@dimen/dimen_10" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/skin_bg_chip" />
            <stroke
                android:width="@dimen/dimen_1"
                android:color="@color/skin_festival_accent" />
            <corners android:radius="@dimen/dimen_10" />
        </shape>
    </item>

</selector>
