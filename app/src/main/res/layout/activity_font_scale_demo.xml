<?xml version="1.0" encoding="utf-8"?><!--
    字体大小设置页：预览 + 档位选择。
    颜色用 font_demo_* 独立一套，页面上不出现 skin_*，所以不接换肤。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/font_demo_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="调大只影响已接入的页面，当前只有 Demo 首页"
            android:textColor="@color/font_demo_hint"
            android:textSize="12sp" />

        <!-- 预览：三行不同量级，字号由代码按档位换算 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            app:cardBackgroundColor="@color/font_demo_card"
            app:cardCornerRadius="@dimen/dimen_12"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimen_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="预览"
                    android:textColor="@color/font_demo_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10"
                    android:text="标题文字"
                    android:textColor="@color/font_demo_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:text="正文段落会跟着档位换算，行高和折行位置一起变。"
                    android:textColor="@color/font_demo_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPreviewHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_6"
                    android:text="辅助说明文字，通常是最小的一档。"
                    android:textColor="@color/font_demo_hint"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 档位：横向平分，选中即写盘 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            app:cardBackgroundColor="@color/font_demo_card"
            app:cardCornerRadius="@dimen/dimen_12"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimen_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="档位"
                    android:textColor="@color/font_demo_hint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSmall"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dimen_40"
                        android:layout_weight="1"
                        android:background="@drawable/font_demo_chip_normal"
                        android:gravity="center"
                        android:text="小"
                        android:textColor="@color/font_demo_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvNormal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dimen_40"
                        android:layout_marginStart="@dimen/dimen_8"
                        android:layout_weight="1"
                        android:background="@drawable/font_demo_chip_normal"
                        android:gravity="center"
                        android:text="标准"
                        android:textColor="@color/font_demo_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLarge"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dimen_40"
                        android:layout_marginStart="@dimen/dimen_8"
                        android:layout_weight="1"
                        android:background="@drawable/font_demo_chip_normal"
                        android:gravity="center"
                        android:text="大"
                        android:textColor="@color/font_demo_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvXLarge"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dimen_40"
                        android:layout_marginStart="@dimen/dimen_8"
                        android:layout_weight="1"
                        android:background="@drawable/font_demo_chip_normal"
                        android:gravity="center"
                        android:text="特大"
                        android:textColor="@color/font_demo_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:paddingStart="@dimen/dimen_4"
            android:paddingEnd="@dimen/dimen_4"
            android:text="选中即保存。返回首页后，首页按新档位重建一次；其余页面保持系统字号。"
            android:textColor="@color/font_demo_hint"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
