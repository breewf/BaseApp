<?xml version="1.0" encoding="utf-8"?><!--
    Banner 自定义页示例(图 + 标题)。
    Banner.setData(items, itemLayoutRes = R.layout.banner_item_title) { page, item, position -> … }
    用 CardView 当根节点,圆角与阴影它自己会裁,配合 banner_pageMargin 的"露边"就是一张卡片轮播。
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivBannerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/banner_item_title_scrim"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="10dp"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
