<?xml version="1.0" encoding="utf-8"?><!--
    共享元素转场 · 单图页(SharedImageDemoActivity)。
    ivCover 用静态 transitionName 配对大图页;点击即带共享元素启动大图页。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="共享元素转场 · 单图"
        android:textColor="@color/black_alpha"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="点下方图片 → Activity→Activity 大图过渡。大图页会先 postponeEnterTransition,等 Glide 把原图解码进 ImageView 再放行,避免过渡期空白。"
        android:textColor="@color/black_alpha"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        android:background="@color/common_background_grey"
        android:clickable="true"
        android:contentDescription="示例封面"
        android:focusable="true"
        android:scaleType="centerCrop"
        android:transitionName="share_cover"
        tools:ignore="UnusedAttribute" />

    <Button
        android:id="@+id/btnViewBig"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/demo_bg_button"
        android:text="查看大图（共享元素转场）"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnGoGrid"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/demo_bg_button_outline"
        android:text="下一个：列表图片 → 详情转场"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp" />

</LinearLayout>
