<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_background_grey"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_12">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4"
            android:layout_marginTop="@dimen/dimen_8"
            android:text="@string/demo_network_title"
            android:textColor="@color/color_333333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4"
            android:layout_marginTop="@dimen/dimen_2"
            android:layout_marginBottom="@dimen/dimen_8"
            android:text="@string/demo_network_subtitle"
            android:textColor="@color/color_999999"
            android:textSize="13sp" />

        <!-- 城市检索 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dimen_14"
            app:cardElevation="@dimen/dimen_1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dimen_10">

                <EditText
                    android:id="@+id/etCity"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_44"
                    android:layout_weight="1"
                    android:background="@drawable/demo_bg_input"
                    android:hint="@string/demo_network_city_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="@string/demo_network_city_default"
                    android:paddingStart="@dimen/dimen_12"
                    android:paddingEnd="@dimen/dimen_12"
                    android:textColor="@color/color_333333"
                    android:textColorHint="@color/color_999999"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_44"
                    android:layout_marginStart="@dimen/dimen_10"
                    android:background="@drawable/demo_bg_button"
                    android:minWidth="@dimen/dimen_80"
                    android:text="@string/demo_network_search"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 当前天气 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            app:cardCornerRadius="@dimen/dimen_16"
            app:cardElevation="@dimen/dimen_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/demo_bg_weather"
                android:orientation="vertical"
                android:padding="@dimen/dimen_18">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="42sp"
                        tools:text="☀️" />

                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_10"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        tools:text="26.4°C" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            tools:text="晴" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_2"
                            android:textColor="@color/demo_white_alpha_70"
                            android:textSize="13sp"
                            tools:text="北京 · 中国" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_14"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="体感 27.1°C ｜ 湿度 45% ｜ 风力 8.5 km/h" />

                <TextView
                    android:id="@+id/tvUpdatedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_6"
                    android:textColor="@color/demo_white_alpha_60"
                    android:textSize="12sp"
                    tools:text="更新时间 10-13 15:30" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 逐日预报 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dimen_14"
            app:cardElevation="@dimen/dimen_1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimen_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/dimen_6"
                    android:text="@string/demo_network_daily_title"
                    android:textColor="@color/color_333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvForecast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_weather_forecast" />

                <TextView
                    android:id="@+id/tvDailyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/dimen_12"
                    android:text="@string/demo_network_daily_empty"
                    android:textColor="@color/color_999999"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 信封接口 / 异常兜底 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dimen_14"
            app:cardElevation="@dimen/dimen_1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimen_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_network_envelope_title"
                    android:textColor="@color/color_333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:lineSpacingExtra="@dimen/dimen_2"
                    android:text="@string/demo_network_result_default"
                    android:textColor="@color/color_666666"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEnvelope"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dimen_44"
                        android:layout_weight="1"
                        android:background="@drawable/demo_bg_button"
                        android:text="@string/demo_network_btn_envelope"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnContent"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dimen_44"
                        android:layout_marginStart="@dimen/dimen_8"
                        android:layout_weight="1"
                        android:background="@drawable/demo_bg_button"
                        android:text="@string/demo_network_btn_content"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnFault"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_44"
                    android:layout_marginTop="@dimen/dimen_8"
                    android:background="@drawable/demo_bg_button_outline"
                    android:text="@string/demo_network_btn_fault"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="@dimen/dimen_34"
            android:layout_height="@dimen/dimen_34"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginBottom="@dimen/dimen_16"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
