<?xml version="1.0" encoding="utf-8"?><!--
    Toast + Snackbar 提示演示页(com.hy.basic.hint)。
    根布局用 CoordinatorLayout:Snackbar 挂在它上面才有滑入滑出动效,并能避让底部系统栏。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轻量提示（Toast + Snackbar）"
                android:textColor="@color/black_alpha"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="调用处只有一个动词：toast(…) / snackbar(…)。样式、时长、上色、找锚点这些都在 ToastKit / SnackbarKit 里统一收口。\nToast 是“最新优先”：连弹只会留下最后一条，多条信息请合并成一条文案。\n实心按钮 = Toast（说完就走），描边按钮 = Snackbar（能带一个操作）。"
                android:textColor="@color/black_alpha"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvInbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/demo_bg_input"
                android:lineSpacingExtra="3dp"
                android:minHeight="72dp"
                android:padding="12dp"
                android:textColor="@color/black_alpha"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnToastShort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/demo_bg_button"
                android:text="1. toast(“保存成功”)（短）"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnToastLong"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button"
                android:text="2. toastLong(…)（长时长）"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnToastBurst"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button"
                android:text="3. 连弹 3 条（只会留下最后一条）"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnToastReplace"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button"
                android:text="4. ToastKit.cancel() 后重弹（覆盖式更新）"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnToastStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button"
                android:text="5. ToastKit.style(…) 切全局位置"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSnack"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button_outline"
                android:text="6. snackbar(…)（不带操作）"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSnackUndo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button_outline"
                android:text="7. snackbar(…, “撤销”) { 真回滚 }"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSnackIndefinite"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/demo_bg_button_outline"
                android:text="8. snackbar 不自动消失（LENGTH_INDEFINITE + 重试）"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/demo_bg_button_outline"
                android:text="清空日志"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/demo_bg_input"
                android:lineSpacingExtra="3dp"
                android:minHeight="140dp"
                android:padding="12dp"
                android:textColor="@color/black_alpha"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
