<?xml version="1.0" encoding="utf-8"?><!--
    侧滑操作行:操作区贴右,按钮由 setupSwipeReveal 动态创建(1~3 项)。
    前景可点击且不透明:未展开时操作区被完全遮住,点击不会穿透到按钮;
    横滑一旦被控制器接管,子 View 会收到 CANCEL,不会误触点击。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/vSwipeActions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/vSwipeForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dimen_16"
        android:paddingTop="@dimen/dimen_12"
        android:paddingEnd="@dimen/dimen_16"
        android:paddingBottom="@dimen/dimen_12">

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="@dimen/dimen_36"
            android:layout_height="@dimen/dimen_36"
            android:background="@drawable/demo_bg_tile"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_333333"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_3"
                android:textColor="@color/color_999999"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8"
            android:text="@string/demo_touch_drag_handle"
            android:textColor="@color/color_c7c7c7"
            android:textSize="20sp" />

    </LinearLayout>

</FrameLayout>
