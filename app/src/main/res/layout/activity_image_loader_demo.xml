<?xml version="1.0" encoding="utf-8"?><!--
    图片加载用法示例页(com.hy.basic.utils.ImageLoader)。
    一页里把 Android 开发中常见的图片加载姿势各演示一遍:形状变换(圆形/圆角/特殊圆角)、
    占位图与错误图、缩放方式、加载监听回调、缩略图过渡、GIF、协程取 Bitmap、预加载。
    样式直接写在布局里,不依赖 style;不展示日志区。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="图片加载（ImageLoader · Glide）"
            android:textColor="@color/black_alpha"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="ImageLoader 把 Glide 的链式调用收成一个入口，页面只说“加载成什么样子”。下面按用法分区展示，每格图片下方标注了对应方法名。"
            android:textColor="@color/black_alpha"
            android:textSize="13sp" />

        <!-- 一、形状变换 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="一、形状变换：圆形 / 圆角 / 特殊圆角"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivCircle"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="圆形"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivRound"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="圆角 12dp"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivRoundTop"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="上圆角下直角"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivRoundFrame"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="左圆右角"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 二、占位图 & 错误图 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="二、占位图 &amp; 错误图（加载中 / 失败兜底）"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/ivHolderOk"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="loadWithHolder · 正常地址"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/ivHolderError"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="loadWithHolder · 错误地址→error图"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 三、加载监听回调 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="三、带监听回调的加载（成功拿尺寸 / 失败提示）"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCallback"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/demo_bg_input"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCallbackStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:minHeight="48dp"
                    android:text="点下面按钮触发一次带回调的加载，这里显示回调结果。"
                    android:textColor="@color/black_alpha"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCallbackOk"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/demo_bg_button"
                    android:text="loadWithCallback · 成功"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCallbackFail"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/demo_bg_button_outline"
                    android:text="loadWithCallback · 失败（错误地址）"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 四、缩略图过渡 & GIF -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="四、缩略图过渡 &amp; GIF 动图"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/ivThumb"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="loadWithThumbnail · 先糊后清"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/ivGif"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/demo_bg_input"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="loadGifImage · 本地 GIF 自动播放"
                    android:textColor="@color/color_666666"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 六、协程取 Bitmap / 预加载 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="六、协程取 Bitmap / 预加载"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBitmap"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/demo_bg_input"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnLoadBitmap"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/demo_bg_button"
                    android:text="loadBitmap( ) · 协程拿 Bitmap 尺寸"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPreload"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/demo_bg_button_outline"
                    android:text="preload( ) · 提前写入缓存"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBitmapInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="还没取过 Bitmap"
                    android:textColor="@color/black_alpha"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 操作日志：记录“调了哪个方法、回调拿到了什么”，与 Banner / Hint 等演示页保持一致写法 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="操作日志"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/demo_bg_button_outline"
            android:text="清空日志"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/demo_bg_input"
            android:lineSpacingExtra="3dp"
            android:minHeight="120dp"
            android:padding="12dp"
            android:textColor="@color/black_alpha"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
