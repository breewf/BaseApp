<?xml version="1.0" encoding="utf-8"?><!--
    换肤验证 Fragment 二：列表复用 + Canvas 自绘。
    item 与自绘都取当前皮肤，Fragment 本身不需要换肤代码。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_bg_page"
    android:orientation="vertical"
    android:padding="@dimen/dimen_16">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fragment · 列表"
        android:textColor="@color/skin_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4"
        android:text="列表 item 复用与 Canvas 自绘都跟随当前皮肤，切肤后滚动不串色。"
        android:textColor="@color/skin_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvToggle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40"
        android:layout_marginTop="@dimen/dimen_10"
        android:background="@color/skin_bg_chip"
        android:gravity="center"
        android:text="切换深浅"
        android:textColor="@color/skin_text_primary"
        android:textSize="13sp" />

    <com.hy.demo.skin.SkinRingView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_120"
        android:layout_marginTop="@dimen/dimen_10" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_8"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
