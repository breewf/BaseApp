<?xml version="1.0" encoding="utf-8"?><!--
    贴底卡片弹框演示布局(BaseDialogFragment + isFullscreen = false / gravity = BOTTOM)。
    窗口背景透明,所以圆角白底由本布局自己画(@drawable/dialog_bg_top_card);
    宽度:卡片皮肤是不悬浮的窗口(windowIsFloating=false),基类在 widthRatio=1f 时直接给窗口
    MATCH_PARENT——悬浮窗口的内容会被主题的 windowMinWidthMajor/Minor 量到 75% 屏宽,
    两侧各剩一条透明层;高度 WRAP_CONTENT 由内容决定;进出场动画在窗口层,整块卡片一起滑入滑出。
    导航栏那一条由基类按 gravity 补成根 View 的 bottom padding,所以这里只写卡片自己的 16dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg_top_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="这次购物还满意吗"
        android:textColor="@color/black_alpha"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="贴底悬浮卡片：宽度占满、高度随内容,从底部滑入。没选星级时按返回键会被拦截（不关闭）。"
        android:textColor="@color/color_999999"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/starBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/star1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/color_c7c7c7"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/star2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/color_c7c7c7"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/star3"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/color_c7c7c7"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/star4"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/color_c7c7c7"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/star5"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/color_c7c7c7"
            android:textSize="30sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="还没选星级"
        android:textColor="@color/color_666666"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/demo_bg_button"
        android:enabled="false"
        android:text="提交"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnLater"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="以后再说"
        android:textColor="@color/color_999999"
        android:textSize="14sp" />

</LinearLayout>
