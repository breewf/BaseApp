<?xml version="1.0" encoding="utf-8"?><!--
    整页 Error(请求/业务失败)状态默认布局(由 PageStateLayout inflate)。
    自定义约定同 page_state_empty.xml。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivPageStateIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/abs_ic_page_state_error" />

    <TextView
        android:id="@+id/tvPageStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="加载失败，点击重试"
        android:textColor="@color/black_alpha"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnPageStateRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/demo_bg_button_outline"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="重试"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp" />

</LinearLayout>
