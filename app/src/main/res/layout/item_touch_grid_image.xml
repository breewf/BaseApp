<?xml version="1.0" encoding="utf-8"?><!--
    九宫格图片项:图片 / 「＋」尾格共用一个布局,按数据切显隐。
    ConstraintLayout 只给 0dp 宽 + 1:1 比例,换屏幕或换列数都保持正方形,不写死高度。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dimen_4">

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/common_background_grey"
        android:contentDescription="@string/demo_touch_image_desc"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAdd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/demo_bg_grid_add"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/demo_touch_add"
        android:textColor="@color/color_999999"
        android:textSize="28sp"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDelete"
        android:layout_width="@dimen/dimen_22"
        android:layout_height="@dimen/dimen_22"
        android:layout_marginEnd="@dimen/dimen_5"
        android:layout_marginTop="@dimen/dimen_5"
        android:background="@drawable/demo_bg_grid_delete"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/demo_touch_delete"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
