<?xml version="1.0" encoding="utf-8"?><!--
    Tab①「简介」:根必须是 NestedScrollView(普通 ScrollView 不会驱动 AppBarLayout 折叠,经典坑)。
    页内竖向滚动经 ViewPager2 → CoordinatorLayout 的嵌套滚动链传上来,头图随之收缩。
    注意:内容必须明显超过一屏 —— NSV 自身滚动范围=内容高-视口高,
    折叠靠嵌套 pre-scroll 就能完成,但吸顶后若自身范围≈0,看起来就是"推不动"。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_background_grey"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_12">

        <!-- 关注/粉丝/获赞 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingTop="@dimen/dimen_16"
            android:paddingBottom="@dimen/dimen_16">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_profile_num_follow"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_2"
                    android:text="@string/demo_profile_label_follow"
                    android:textColor="@color/color_666666"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_profile_num_fans"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_2"
                    android:text="@string/demo_profile_label_fans"
                    android:textColor="@color/color_666666"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_profile_num_like"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_2"
                    android:text="@string/demo_profile_label_like"
                    android:textColor="@color/color_666666"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 基本资料 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="@dimen/dimen_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基本资料"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:drawablePadding="@dimen/dimen_8"
                android:text="昵称:张三"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="性别:男        年龄:28"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:text="城市:杭州        职业:Android 开发工程师"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 长内容:页面滚得动,折叠才演示得充分 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:background="@color/white"
            android:lineSpacingExtra="@dimen/dimen_6"
            android:padding="@dimen/dimen_16"
            android:text="个人简介:深耕 Android 多年,主导过组件化框架、UI 基础库与一套 MVVM 基类。相信好的界面是「磨」出来的:每一处动效、每一像素的间距,都值得推敲。欢迎在动态页查看我的近期分享,或在相册页浏览摄影作品。继续下滑,注意观察头图视差收缩与 Tab 吸顶的联动过程 —— 吸顶后内容还能接着滚,靠的就是本页把区块总高度垫超过一屏。"
            android:textColor="@color/color_666666"
            android:textSize="13sp" />

        <!-- 经历:把内容总高垫到明显超过一屏,吸顶后 NSV 才有剩余滚动范围 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="@dimen/dimen_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="经历"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="2021.03 - 至今｜某科技公司 · Android 架构组"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="主导组件化框架与 UI 基础库建设、网络框架、富文本工具等通用能力"
                android:textColor="@color/color_666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="2018.07 - 2021.02｜某互联网公司 · 客户端开发"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="负责电商 App 详情页与支付链路,首屏加载耗时优化降低 40%"
                android:textColor="@color/color_666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="2016.09 - 2018.06｜某软件公司 · 客户端开发"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="参与 IM 项目从 Java 到 Kotlin 的渐进式改写,负责消息缓存与离线同步模块"
                android:textColor="@color/color_666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12"
                android:text="2012 - 2016｜杭州电子科技大学 · 软件工程(本科)"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_2"
                android:text="ACM 校赛一等奖,毕业设计题目是移动端图表组件库"
                android:textColor="@color/color_666666"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/demo_white_alpha_70"
            android:lineSpacingExtra="@dimen/dimen_2"
            android:padding="@dimen/dimen_12"
            android:text="@string/demo_profile_info_tip"
            android:textColor="@color/color_666666"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
