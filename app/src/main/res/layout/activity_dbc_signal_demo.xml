<?xml version="1.0" encoding="utf-8"?>
<!-- DBC 解析验证页:解析结果 + 仿真帧解码,文本用等宽字体方便看 raw -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/skin_bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="点击按钮切换 DBC 组,下方展示当前组的原文和解析结果;点击结果区可切换样例数据。"
            android:textColor="@color/skin_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDecode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/demo_bg_button"
            android:text="切换 DBC 组"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/skin_bg_chip"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:minHeight="480dp"
            android:padding="12dp"
            android:textColor="@color/skin_text_primary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
