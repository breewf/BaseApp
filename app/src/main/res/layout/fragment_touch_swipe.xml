<?xml version="1.0" encoding="utf-8"?><!--
    侧滑操作页:顶部说明 + 运行时开关,下面是同一个列表(长按拖拽 + 左滑操作 + 点击)。
    侧滑只平移前景,操作区固定在行下面,滑开后停住。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_background_grey"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="@dimen/dimen_12"
        android:text="@string/demo_touch_swipe_tip"
        android:textColor="@color/color_666666"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dimen_12"
        android:paddingEnd="@dimen/dimen_12"
        android:paddingBottom="@dimen/dimen_10">

        <TextView
            android:id="@+id/btnDrag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/demo_bg_button"
            android:paddingStart="@dimen/dimen_12"
            android:paddingTop="@dimen/dimen_6"
            android:paddingEnd="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_6"
            android:text="@string/demo_touch_btn_drag_on"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSwipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8"
            android:background="@drawable/demo_bg_button"
            android:paddingStart="@dimen/dimen_12"
            android:paddingTop="@dimen/dimen_6"
            android:paddingEnd="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_6"
            android:text="@string/demo_touch_btn_swipe_on"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8"
            android:background="@drawable/demo_bg_button_outline"
            android:paddingStart="@dimen/dimen_12"
            android:paddingTop="@dimen/dimen_6"
            android:paddingEnd="@dimen/dimen_12"
            android:paddingBottom="@dimen/dimen_6"
            android:text="@string/demo_touch_btn_reset"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white" />

</LinearLayout>
