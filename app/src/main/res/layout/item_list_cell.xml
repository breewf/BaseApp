<?xml version="1.0" encoding="utf-8"?><!--
    横向 / 网格共用列表项:图标 + 文字。
    同一布局被横向 LinearManager 与网格 GridManager 复用 —— 横向时按 wrap 排布,
    网格时每列被 GridLayoutManager 拉成等宽(本布局 layout_width 被列宽覆盖),故用居中内容即可两端适配。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/dimen_12"
    android:paddingTop="@dimen/dimen_10"
    android:paddingEnd="@dimen/dimen_12"
    android:paddingBottom="@dimen/dimen_10">

    <ImageView
        android:id="@+id/ivCell"
        android:layout_width="@dimen/dimen_60"
        android:layout_height="@dimen/dimen_60"
        android:background="@color/common_background_grey"
        android:contentDescription="@string/demo_palette_cover_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6"
        android:textColor="@color/color_333333"
        android:textSize="13sp" />

</LinearLayout>
