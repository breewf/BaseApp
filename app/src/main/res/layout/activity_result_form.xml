<?xml version="1.0" encoding="utf-8"?><!--
    表单回传页:提交时 ViewModel 只发 UiEvent.ShowResult,基类自动 setResult + finish。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="填写后提交,数据将回传给拉起方"
        android:textColor="@color/black_alpha"
        android:textSize="18sp"
        android:layout_marginTop="40dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/demo_bg_input"
        android:hint="标题(必填)"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etRemark"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/demo_bg_input"
        android:hint="备注(可空)"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/demo_bg_button"
        android:text="提交并回传结果(ShowResult 事件)"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnGiveUp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/demo_bg_button_outline"
        android:text="放弃并返回(GoBack 事件,拉起方收到 CANCELED)"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp" />

</LinearLayout>
